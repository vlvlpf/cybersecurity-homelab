//Допустим необходимо считать еще количество удачных входов, тогда нужно добавить новый паттерн в скрипт



import re
from collections import Counter

LOG_FILE = "../logs/auth.log"

# Счетчики для неудачных и удачных попыток
failed_ips = Counter()
successful_logins = Counter() # Можно считать по IP, а можно по именам пользователей

# 1. Паттерн для неудачных входов (как было)
pattern_failed = re.compile(
    r"Failed password.*from (\d+\.\d+\.\d+\.\d+)"
)

# 2. Новый паттерн для УДАЧНЫХ входов
# Ищем "Accepted password" или "Accepted publickey", 
# берем имя пользователя (\S+) и IP-адрес (\d+...)
pattern_success = re.compile(
    r"Accepted (?:password|publickey) for (\S+) from (\d+\.\d+\.\d+\.\d+)"
)

with open(LOG_FILE, "r", errors="ignore") as file:
    for line in file:
        
        # Проверяем на неудачный вход
        match_failed = pattern_failed.search(line)
        if match_failed:
            ip = match_failed.group(1)
            failed_ips[ip] += 1
            continue # Если нашли неудачу, дальше строку не проверяем
            
        # Проверяем на удачный вход
        match_success = pattern_success.search(line)
        if match_success:
            user = match_success.group(1)
            ip = match_success.group(2)
            # Сохраняем связку: пользователь и IP, например: "root@192.168.1.5"
            successful_logins[f"{user}@{ip}"] += 1

print("\n=== SECURITY REPORT ===\n")

print("--- Неудачные попытки (Потенциальный брутфорс) ---")
for ip, count in failed_ips.most_common():
    if count >= 5:
        print(f"[ALERT] {ip}: {count} failed attempts")
    else:
        print(f"[INFO] {ip}: {count} failed attempts")

print("\n--- Успешные входы (Удостоверьтесь, что это вы) ---")
for login_info, count in successful_logins.most_common():
    print(f"[SUCCESS] Вход: {login_info} (Количество: {count})")



